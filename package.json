{
  "name": "binaural-beat-laboratory",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --cwd packages/web dev",
    "build": "bun run --cwd packages/web build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "tsc -p tsconfig.json",
    "preview": "bun run --cwd packages/web preview",
    "format": "prettier --write packages tests *.ts *.json *.md",
    "deploy": "alchemy deploy --stage production",
    "deploy:email": "alchemy deploy alchemy.email.ts --stage production",
    "test:e2e:static": "bun run build && TEST_STATIC=1 playwright test",
    "generate:social": "bun scripts/generate-social.tsx"
  },
  "dependencies": {
    "@effect-atom/atom": "^0.5.0",
    "@effect-atom/atom-react": "^0.5.0",
    "@effect/experimental": "~0.58.0",
    "@effect/platform": "~0.94.2",
    "@effect/rpc": "~0.73.0",
    "@lucas-barake/effect-form-react": "0.25.0",
    "@radix-ui/react-slot": "^1.2.3",
    "@tanstack/react-router": "^1.170.45",
    "@tanstack/react-start": "^1.169.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "effect": "^3.19.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.3.0"
  },
  "devDependencies": {
    "@effect/vitest": "^0.27.0",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.1.2",
    "alchemy": "0.94.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^8",
    "vitest": "^3.2.0"
  },
  "workspaces": [
    "packages/*"
  ]
}
